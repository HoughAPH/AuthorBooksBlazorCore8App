@page "/authors"
@using Microsoft.AspNetCore.Components.Authorization
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAuthors AuthorsService
@inject SweetAlertService Swal
@inject NavigationManager Navigation

<PageTitle>Authors</PageTitle>

<h3 class="mb-2">Authors</h3>
<AuthorizeView Roles="Admin">
    <Authorized>
        <button class="btn btn-primary" @onclick="NavigateToAuthorPage">
            Create New
        </button>
    </Authorized>
</AuthorizeView>

@if (authors is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-sm table-striped mt-2" style="--bs-table-striped-bg: rgba(0, 0, 0, 0.15);">
        <tbody>
            @foreach (var author in authors)
            {
                <tr>
                    <td>@author.Name</td>
                    <td>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <button type="button" class="btn btn-primary" @onclick="@(() => NavigateToEditAuthorPage(author.Id))">
                                    <i class="oi oi-pencil">Edit</i>
                                </button>
                                <button id="DeleteAuthor" type="button" class="btn btn-danger btn-sm ms-2" @onclick="@(async () => await DeleteAsync(author.Id))">
                                    <i class="oi oi-trash">Delete</i>
                                </button>
                            </Authorized>
                        </AuthorizeView>

                        <a class="btn btn-primary btn-sm" href="/books/@author.Id">
                            <i class="oi oi-pencil">Author Books</i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AuthorDTO>? authors;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorsAsync();
    }

    private async Task LoadAuthorsAsync()
    {
        authors = await AuthorsService.GetAuthors();
    }

    private async Task DeleteAsync(int id)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete Author",
            Text = "Do you want to delete the author?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (!result.IsConfirmed)
        {
            return;
        }

        var response = await AuthorsService.DeleteAuthor(id);

        if (response.Flag)
        {
            await LoadAuthorsAsync();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Success",
                Text = response.Message,
                Icon = SweetAlertIcon.Success,
                ShowCancelButton = false
            });

            return;
        }

        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Error deleting author",
            Text = response.Message,
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = false
        });
    }

    private void NavigateToEditAuthorPage(int authorId)
    {
        Navigation.NavigateTo($"/author/{authorId}");
    }

    private void NavigateToAuthorPage()
    {
        Navigation.NavigateTo("/author");
    }
}

