@page "/books"
@page "/books/{AuthorId:int}"
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using CurrieTechnologies.Razor.SweetAlert2
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize]
@inject IBooks BookService
@inject NavigationManager NavigationManager
@inject SweetAlertService Swal;

<PageTitle>Books</PageTitle>

<AuthorizeView Roles="Admin">
    <Authorized>
        <button class="btn btn-primary" @onclick="@(() => NavigateToBookPage(0))">
            New Book
        </button>
    </Authorized>
</AuthorizeView>

@if (books == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-interactive">
        <table class="table-primary">
            <thead>
                <tr>
                    @*   <th>Id</th> *@
                    <th>Title</th>
                    <th>Author Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in books)
                {
                    <tr>
                        @* <td>@book.Id</td> *@
                        <td>@book.Title</td>
                        <td>@book.AuthorName</td>
                        <td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button type="button" class="btn btn-primary" @onclick="@(() => NavigateToBookPage(book.Id))">
                                        <i class="oi oi-pencil">Edit</i>
                                    </button>
                                    <button type="button" class="btn btn-danger btn-sm ms-2" @onclick="@(async () => await DeleteAsync(book))">
                                        <i class="oi oi-trash">Delete</i>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public int AuthorId { get; set; } = 0;

    private IEnumerable<BookDTO>? books;
    // private SharedClassLibrary.DTOs.Author author = new();

    protected override async Task OnParametersSetAsync()
    {
        // if(string.IsNullOrEmpty(role))
        // {
        //     NavigationManager.NavigateTo("/login");
        // }

        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        if (AuthorId != 0)
        {
            books = await BookService.GetAuthorBooks(AuthorId);
        }
        else
        {
            books = await BookService.GetBooks();
        }
    }

    private async Task DeleteAsync(BookDTO book)
    {
        //bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure?");
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete Book",
            Text = "Do you want to delete the book?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (result.IsConfirmed)
        {
            await BookService.DeleteBook(book.Id);
            await LoadBooksAsync();
        }
    }

    private void NavigateToBookPage(int bookId)
    {
        if (bookId == 0)
        {
            NavigationManager.NavigateTo("/book");
        }
        else
        {
            NavigationManager.NavigateTo($"/book/{bookId}");
        }
    }
}
