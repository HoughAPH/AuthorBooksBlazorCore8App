@page "/resetpassword"

@using Microsoft.AspNetCore.Components
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs

@inject IUserAccount AccountService
@inject IJSRuntime js

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <EditForm Enhance Model="User" OnValidSubmit="HandleResetPassword">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="card-header">Reset Password</div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <InputText @bind-Value="User.Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="Email Address">
                        </InputText>
                    </div>
                    <div class="form-group mb-3">
                        <InputText @bind-Value="User.Token"
                                   class="form-control"
                                   placeholder="Reset Token">
                        </InputText>
                    </div>
                    <div class="form-group mb-3">
                        <InputText @bind-Value="User.Password"
                                   class="form-control"
                                   type="password"
                                   placeholder="New Password">
                        </InputText>
                    </div>
                    <div class="form-group mb-3">
                        <InputText @bind-Value="User.ConfirmPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Confirm Password">
                        </InputText>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary float-end"
                            type="submit">
                        Reset Password
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    public ResetPasswordDTO User { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Token))
            User.Token = Token;
        if (!string.IsNullOrEmpty(Email))
            User.Email = Email;
    }

    async Task HandleResetPassword()
    {
        Result result = await AccountService.ResetPassword(User);
        await js.InvokeVoidAsync("alert", result.Message);
    }
}
