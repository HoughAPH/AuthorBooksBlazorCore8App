@page "/resetpassword"

@using Microsoft.AspNetCore.Components
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs

@inject IUserAccount AccountService
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Reset password</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-4">
        <EditForm Enhance Model="User" OnValidSubmit="HandleResetPassword">
            <DataAnnotationsValidator />
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Reset password</div>
                <div class="card-body">
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="ResetEmail" class="form-label">Email address</label>
                        <InputText id="ResetEmail" @bind-Value="User.Email" class="form-control" type="email" />
                    </div>
                    <div class="mb-3">
                        <label for="ResetToken" class="form-label">Reset token</label>
                        <InputText id="ResetToken" @bind-Value="User.Token" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="ResetPassword" class="form-label">New password</label>
                        <InputText id="ResetPassword" @bind-Value="User.Password" class="form-control" type="password" />
                    </div>
                    <div class="mb-3">
                        <label for="ResetConfirm" class="form-label">Confirm password</label>
                        <InputText id="ResetConfirm" @bind-Value="User.ConfirmPassword" class="form-control" type="password" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Reset password</button>
                </div>
                <div class="card-footer text-body-secondary">
                    <a href="/login">Back to login</a>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    public ResetPasswordDTO User { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Token))
            User.Token = Token;
        if (!string.IsNullOrEmpty(Email))
            User.Email = Email;
    }

    async Task HandleResetPassword()
    {
        Result result = await AccountService.ResetPassword(User);

        if (result.Succeeded)
        {
            await NotificationService.ShowSuccessAsync(result.Message);
            Navigation.NavigateTo("/login");
            return;
        }

        await NotificationService.ShowWarningAsync(result.Message, "Password not reset");
    }
}
