@page "/register"
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IUserAccount AccountService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService

<PageTitle>Sign up</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-4">
        <EditForm Model="User" OnValidSubmit="HandleRegistration" Enhance>
            <DataAnnotationsValidator />
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Create an account</div>
                <div class="card-body">
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="RegName" class="form-label">Full name</label>
                        <InputText id="RegName" @bind-Value="User.Name" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="RegEmail" class="form-label">Email address</label>
                        <InputText id="RegEmail" @bind-Value="User.Email" class="form-control" type="email" />
                    </div>

                    @if (role == "Admin")
                    {
                        <div class="mb-3">
                            <label for="RegRole" class="form-label">Role</label>
                            <InputSelect id="RegRole" class="form-select" @bind-Value="User.Role">
                                <option value="User">User</option>
                                <option value="Author">Author</option>
                            </InputSelect>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="RegPassword" class="form-label">Password</label>
                        <div class="input-group">
                            <InputText id="RegPassword" @bind-Value="User.Password" class="form-control"
                                       type="@(ShowPassword ? "text" : "password")" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ShowPasswordEvent">
                                @(ShowPassword ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="RegConfirm" class="form-label">Confirm password</label>
                        <div class="input-group">
                            <InputText id="RegConfirm" @bind-Value="User.ConfirmPassword" class="form-control"
                                       type="@(ShowConfirmPassword ? "text" : "password")" />
                            <button class="btn btn-outline-secondary" type="button" @onclick="ShowConfirmPasswordEvent">
                                @(ShowConfirmPassword ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Register</button>
                </div>
                <div class="card-footer text-body-secondary">
                    Already registered? <a href="/login">Login instead</a>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    public bool ShowPassword { get; set; }
    public bool ShowConfirmPassword { get; set; }
    private string role = string.Empty;
    public UserDTO User { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        role = authState.User?.IsInRole("Admin") == true ? "Admin" : string.Empty;
    }

    private async Task HandleRegistration()
    {
        Result result = await AccountService.CreateAccount(User);

        if (result.Succeeded)
        {
            await NotificationService.ShowSuccessAsync(result.Message);
            User = new();
            return;
        }

        await NotificationService.ShowWarningAsync(result.Message, "Registration failed");
    }

    void ShowPasswordEvent() => ShowPassword = !ShowPassword;
    void ShowConfirmPasswordEvent() => ShowConfirmPassword = !ShowConfirmPassword;
}
