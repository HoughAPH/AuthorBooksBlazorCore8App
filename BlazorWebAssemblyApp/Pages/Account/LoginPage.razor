@page "/login"
@using BlazorWebAssemblyApp.Authentication
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IUserAccount AccountService
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService

<PageTitle>Login</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-4">
        <EditForm Model="User" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Login to your account</div>
                <div class="card-body">
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="LoginEmail" class="form-label">Email address</label>
                        <InputText id="LoginEmail" @bind-Value="User.Email" class="form-control" type="email" />
                    </div>

                    <div class="mb-3">
                        <label for="LoginPassword" class="form-label">Password</label>
                        <InputText id="LoginPassword" @bind-Value="User.Password" class="form-control" type="password" />
                    </div>

                    <button class="btn btn-primary w-100" type="submit">Login</button>
                </div>
                <div class="card-footer text-body-secondary">
                    Forgot your password? <a href="/forgotpassword">Reset it</a>
                    <br />
                    New here? <a href="/register">Create an account</a>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    public LoginDTO User { get; set; } = new();

    private async Task HandleLogin()
    {
        var response = await AccountService.LoginAccount(User);

        if (response.Succeeded)
        {
            await AuthStateProvider.RefreshUserStateAsync();
            NavManager.NavigateTo("/", forceLoad: false);
            return;
        }

        await NotificationService.ShowWarningAsync(response.Message, "Login failed");
    }
}
