@page "/book"
@page "/book/{IdEdit:int}"
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IBooks BookService
@inject IAuthors AuthorService
@inject NavigationManager Navigation

<PageTitle>Book</PageTitle>

@if (book == null)
{
    <p><em>Retrieving the book...</em></p>
}
else
{
    <div class="container mt-5 shadow-sm">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title">@headerTitle</h3>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <button type="button" class="btn btn-secondary" @onclick="NavigateBackToList">
                                @(IdEdit != 0 ? "Back to List" : "Cancel")
                            </button>
                        </div>
                        <EditForm Enhance Model="book" OnValidSubmit="OnValidSubmitAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mb-3">
                                <label for="BookTitle" class="form-label fw-bold">Title</label>
                                <InputText id="BookTitle" class="form-control" @bind-Value="book.Title"></InputText>
                            </div>
                            <div class="mb-3">
                                <label for="BookAuthor" class="form-label fw-bold">Author</label>
                                <InputSelect id="BookAuthor" class="form-control" @bind-Value="book.AuthorId">
                                    <option value="0">-- SELECT --</option>
                                    @foreach (var author in authors)
                                    {
                                        <option value="@author.Id">@author.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="card-footer bg-light d-flex justify-content-start py-3">
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int IdEdit { get; set; } = 0;

    private BookDTO? book;
    private string headerTitle = "Create New Book";
    private List<AuthorDTO> authors = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IdEdit != 0)
        {
            book = await BookService.GetBook(IdEdit);
            headerTitle = "Edit Book Details";
        }
        else
        {
            book = new();
            headerTitle = "Create New Book";
        }

        authors = await AuthorService.GetAuthors();
    }

    private async Task OnValidSubmitAsync()
    {
        if (book is null)
        {
            return;
        }

        if (IdEdit != 0)
        {
            await BookService.UpdateBook(IdEdit, book);
        }
        else
        {
            await BookService.AddBook(book);
        }

        Navigation.NavigateTo("/books");
    }
    private void NavigateBackToList()
    {
        Navigation.NavigateTo("/books");
    }
}
