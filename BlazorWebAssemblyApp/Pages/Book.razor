@page "/book"
@page "/book/{IdEdit:int}"
@page "/book/author/{AuthorId:int}"
@page "/book/{IdEdit:int}/author/{AuthorId:int}"
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using CurrieTechnologies.Razor.SweetAlert2
@attribute [Authorize(Roles = "Admin")]
@inject IBooks BookService
@inject IAuthors AuthorService
@inject NavigationManager Navigation
@inject SweetAlertService Swal

<PageTitle>Book</PageTitle>

@if (book == null)
{
    <p><em>Retrieving the book...</em></p>
}
else
{
    <div class="container mt-5 shadow-sm">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title">@headerTitle</h3>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <button type="button" class="btn btn-secondary" @onclick="NavigateBackToList">
                                @(IdEdit != 0 ? "Back to List" : "Cancel")
                            </button>
                        </div>
                        <EditForm Enhance Model="book" OnValidSubmit="OnValidSubmitAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mb-3">
                                <label for="BookTitle" class="form-label fw-bold">Title</label>
                                <InputText id="BookTitle" class="form-control" @bind-Value="book.Title"></InputText>
                            </div>
                            <div class="mb-3">
                                <label for="BookAuthor" class="form-label fw-bold">Author</label>
                                <InputSelect id="BookAuthor" class="form-control" @bind-Value="book.AuthorId" disabled="@(authors?.Count <= 1)">
                                    @if (authors?.Count > 1)
                                    {
                                        <option value="0">-- SELECT --</option>
                                    }
                                    @if (authors is not null)
                                    {
                                        @foreach (var author in authors)
                                        {
                                            <option value="@author.Id">@author.Name</option>
                                        }
                                    }
                                    </InputSelect>
                                    </div>
                                    <div class="card-footer bg-light d-flex justify-content-start py-3">
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter]
    public int IdEdit { get; set; } = 0;

    [Parameter]
    public int AuthorId { get; set; } = 0;

    private BookDTO? book;
    private string headerTitle = "Create New Book";
    private List<AuthorDTO> authors = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IdEdit != 0)
        {
            book = await BookService.GetBook(IdEdit);
            headerTitle = "Edit Book Details";
        }
        else
        {
            book = new();
            headerTitle = "Create New Book";
        }

        if (AuthorId != 0)
        {
            AuthorDTO? author = await AuthorService.GetAuthor(AuthorId);

            authors = author is null ? [] : [author];

            if (book is not null && author is not null)
            {
                book.AuthorId = author.Id;
                book.AuthorName = author.Name;
            }
        }
        else
        {
            authors = await AuthorService.GetAuthors();
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (book is null)
        {
            return;
        }

        SharedClassLibrary.Models.ServiceResponses.GeneralResponse response = IdEdit != 0
            ? await BookService.UpdateBook(IdEdit, book)
            : await BookService.AddBook(book);

        if (response.Flag)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Success",
                Text = response.Message,
                Icon = SweetAlertIcon.Success,
                ShowCancelButton = false
            });

            NavigateBackToList();
            return;
        }

        await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Error",
            Text = response.Message,
            Icon = SweetAlertIcon.Error,
            ShowCancelButton = false
        });
    }

    private void NavigateBackToList()
    {
        if (AuthorId != 0)
        {
            Navigation.NavigateTo($"/books/{AuthorId}");
            return;
        }

        Navigation.NavigateTo("/books");
    }
}
