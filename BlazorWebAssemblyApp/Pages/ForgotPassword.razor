@page "/forgotpassword"

@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using System.ComponentModel.DataAnnotations

@inject IUserAccount AccountService
@inject IJSRuntime js
@inject NavigationManager Navigation

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <EditForm Enhance Model="User" OnValidSubmit="HandleForgotPassword">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="card-header">Forgot Password</div>

                <div class="card-body">
                    <div class="form-group mb-3">
                        <InputText @bind-Value="User.Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="Email Address" />
                    </div>
                </div>

                <div class="card-footer">
                    <button class="btn btn-primary float-end" type="submit">
                        Send Reset Link
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    public ForgotPasswordDTO User { get; set; } = new();

    async Task HandleForgotPassword()
    {
        var (flag, message) = await AccountService.ForgotPassword(User);

        if (!flag)
        {
            await js.InvokeVoidAsync("alert", message);
            return;
        }

        var email = Uri.EscapeDataString(User.Email ?? string.Empty);
        var token = Uri.EscapeDataString(message);

        Navigation.NavigateTo($"/resetpassword?email={email}&token={token}");
    }
}
