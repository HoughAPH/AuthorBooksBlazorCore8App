@page "/books"
@page "/books/{AuthorId:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@using SharedClassLibrary.Models
@attribute [Authorize]
@inject IBooks BookService
@inject IAuthors AuthorService
@inject NavigationManager NavigationManager
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService

<PageTitle>Books</PageTitle>

<div class="mb-3">
    @if (AuthorId != 0)
    {
        <div class="mb-2">
            <button type="button" class="btn btn-secondary" @onclick="ShowAllBooks">
                Show All Books
            </button>
        </div>
    }

    <h3 class="mb-2">@pageHeading</h3>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="btn btn-primary" @onclick="@(() => NavigateToBookPage(0))">
                New Book
            </button>
        </Authorized>
    </AuthorizeView>
</div>

@if (books == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-interactive">
        <table class="table table-sm table-striped" style="--bs-table-striped-bg: rgba(0, 0, 0, 0.15);">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author Name</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (BookDTO book in books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.AuthorName</td>
                        <td>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button type="button" class="btn btn-primary" @onclick="@(() => NavigateToBookPage(book.Id))">
                                        <i class="icon-link oi oi-pencil">Edit</i>
                                    </button>
                                    <button type="button" class="btn btn-danger btn-sm ms-2" @onclick="@(async () => await DeleteAsync(book))">
                                        <i class="icon-link oi oi-trash">Delete</i>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (totalPages > 1)
        {
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        OnPageChanged="HandlePageChangedAsync" />
        }
    </div>
}

@code {
    [Parameter]
    public int AuthorId { get; set; } = 0;

    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages;
    private IEnumerable<BookDTO>? books;
    private IEnumerable<BookDTO> allBooks = [];
    private string pageHeading = "All Books";

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadPageStateAsync();
    }

    private async Task LoadPageStateAsync()
    {
        if (AuthorId != 0)
        {
            AuthorDTO? author = await AuthorService.GetAuthor(AuthorId);
            pageHeading = author is null
                ? "Books for Selected Author"
                : $"Books for {author.Name}";

            allBooks = await BookService.GetAuthorBooks(AuthorId);
        }
        else
        {
            pageHeading = "All Books";
            allBooks = await BookService.GetBooks();
        }

        var totalItems = allBooks.Count();
        totalPages = totalItems == 0
            ? 1
            : (int)Math.Ceiling((double)totalItems / pageSize);

        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }

        books = allBooks
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private async Task HandlePageChangedAsync(int page)
    {
        currentPage = page;
        await LoadPageStateAsync();
    }

    private async Task DeleteAsync(BookDTO book)
    {
        bool confirmed = await NotificationService.ConfirmAsync(
            "Delete Book",
            $"Do you want to delete the book '{book.Title}'?");

        if (!confirmed)
        {
            return;
        }

        Result response =
            await BookService.DeleteBook(book.Id);

        if (response.Succeeded)
        {
            await NotificationService.ShowSuccessAsync(response.Message, "Deleted!");
        }
        else
        {
            await NotificationService.ShowErrorAsync(response.Message, "Error!");
        }

        await LoadPageStateAsync();
    }

    private void NavigateToBookPage(int bookId)
    {
        if (AuthorId != 0)
        {
            if (bookId == 0)
            {
                NavigationManager.NavigateTo($"/book/author/{AuthorId}");
            }
            else
            {
                NavigationManager.NavigateTo($"/book/{bookId}/author/{AuthorId}");
            }

            return;
        }

        if (bookId == 0)
        {
            NavigationManager.NavigateTo("/book");
        }
        else
        {
            NavigationManager.NavigateTo($"/book/{bookId}");
        }
    }

    private void ShowAllBooks()
    {
        NavigationManager.NavigateTo("/books");
    }
}
