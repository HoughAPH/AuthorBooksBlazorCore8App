@page "/books"
@page "/books/{AuthorId:int}"
@using Microsoft.AspNetCore.Components.Authorization
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@using SharedClassLibrary.Models
@attribute [Authorize]
@inject IBooks BookService
@inject IAuthors AuthorService
@inject NavigationManager NavigationManager
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService

<PageTitle>Books</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@pageHeading</h2>
    <div class="d-flex gap-2">
        @if (AuthorId != 0)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="ShowAllBooks">Show All Books</button>
        }
        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="btn btn-primary" @onclick="@(() => NavigateToBookPage(0))">New Book</button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6 col-xl-4">
        <div class="input-group">
            <input class="form-control" placeholder="Search title or author" aria-label="Search books"
                   @bind="search" @bind:event="oninput" @onkeydown="OnSearchKeyDownAsync" />
            <button class="btn btn-outline-secondary" type="button" @onclick="SearchAsync">Search</button>
        </div>
    </div>
</div>

@if (books == null)
{
    <div class="d-flex align-items-center gap-2 text-secondary">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading...</span>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="fw-bold">Title</th>
                    <th scope="col" class="fw-bold">Author Name</th>
                    <th scope="col" class="fw-bold">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (BookDTO book in books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.AuthorName</td>
                        <td class="text-nowrap">
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => NavigateToBookPage(book.Id))">Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" @onclick="@(async () => await DeleteAsync(book))">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
                @if (!books.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-secondary py-4">No books found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    OnPageChanged="HandlePageChangedAsync" />
    }
}

@code {
    [Parameter]
    public int AuthorId { get; set; } = 0;

    private int currentPage = 1;
    private const int pageSize = 5;
    private int totalPages = 1;
    private IEnumerable<BookDTO>? books;
    private string pageHeading = "All Books";
    private string search = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadPageStateAsync();
    }

    private async Task LoadPageStateAsync()
    {
        if (AuthorId != 0)
        {
            AuthorDTO? author = await AuthorService.GetAuthor(AuthorId);
            pageHeading = author is null
                ? "Books for Selected Author"
                : $"Books for {author.Name}";
        }
        else
        {
            pageHeading = "All Books";
        }

        int? authorFilter = AuthorId != 0 ? AuthorId : null;
        PagedResult<BookDTO> page = await BookService.GetBooksPage(currentPage, pageSize, search, authorFilter);

        totalPages = Math.Max(page.TotalPages, 1);

        // The last page can disappear after a delete; step back and reload.
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
            page = await BookService.GetBooksPage(currentPage, pageSize, search, authorFilter);
        }

        books = page.Items;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadPageStateAsync();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task HandlePageChangedAsync(int page)
    {
        currentPage = page;
        await LoadPageStateAsync();
    }

    private async Task DeleteAsync(BookDTO book)
    {
        bool confirmed = await NotificationService.ConfirmAsync(
            "Delete Book",
            $"Do you want to delete the book '{book.Title}'?");

        if (!confirmed)
        {
            return;
        }

        Result response =
            await BookService.DeleteBook(book.Id);

        if (response.Succeeded)
        {
            await NotificationService.ShowSuccessAsync(response.Message, "Deleted!");
        }
        else
        {
            await NotificationService.ShowErrorAsync(response.Message, "Error!");
        }

        await LoadPageStateAsync();
    }

    private void NavigateToBookPage(int bookId)
    {
        if (AuthorId != 0)
        {
            if (bookId == 0)
            {
                NavigationManager.NavigateTo($"/book/author/{AuthorId}");
            }
            else
            {
                NavigationManager.NavigateTo($"/book/{bookId}/author/{AuthorId}");
            }

            return;
        }

        if (bookId == 0)
        {
            NavigationManager.NavigateTo("/book");
        }
        else
        {
            NavigationManager.NavigateTo($"/book/{bookId}");
        }
    }

    private void ShowAllBooks()
    {
        NavigationManager.NavigateTo("/books");
    }
}
