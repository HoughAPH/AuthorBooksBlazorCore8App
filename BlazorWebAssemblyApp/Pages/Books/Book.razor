@page "/book"
@page "/book/{IdEdit:int}"
@page "/book/author/{AuthorId:int}"
@page "/book/{IdEdit:int}/author/{AuthorId:int}"
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IBooks BookService
@inject IAuthors AuthorService
@inject NavigationManager Navigation
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService

<PageTitle>Book</PageTitle>

@if (book == null)
{
    <div class="d-flex align-items-center gap-2 text-secondary">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading...</span>
    </div>
}
else
{
    <div>
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBackToList">
                        @(IdEdit != 0 ? "Back to List" : "Cancel")
                    </button>
                </div>
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h2 class="card-title h4 mb-0">@headerTitle</h2>
                    </div>
                    <div class="card-body">
                        <EditForm Enhance Model="book" OnValidSubmit="OnValidSubmitAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mb-3">
                                <label for="BookTitle" class="form-label fw-bold">Title</label>
                                <InputText id="BookTitle" class="form-control" @bind-Value="book.Title"></InputText>
                            </div>
                            <div class="mb-3">
                                <label for="BookAuthor" class="form-label fw-bold">Author</label>
                                <InputSelect id="BookAuthor" class="form-select" @bind-Value="book.AuthorId" disabled="@(authors?.Count <= 1)">
                                    @if (authors?.Count > 1)
                                    {
                                        <option value="0">-- SELECT --</option>
                                    }
                                    @if (authors is not null)
                                    {
                                        @foreach (var author in authors)
                                        {
                                            <option value="@author.Id">@author.Name</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int IdEdit { get; set; } = 0;

    [Parameter]
    public int AuthorId { get; set; } = 0;

    private BookDTO? book;
    private string headerTitle = "Create New Book";
    private List<AuthorDTO> authors = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IdEdit != 0)
        {
            book = await BookService.GetBook(IdEdit);
            headerTitle = "Edit Book Details";
        }
        else
        {
            book = new();
            headerTitle = "Create New Book";
        }

        if (AuthorId != 0)
        {
            AuthorDTO? author = await AuthorService.GetAuthor(AuthorId);

            authors = author is null ? [] : [author];

            if (book is not null && author is not null)
            {
                book.AuthorId = author.Id;
                book.AuthorName = author.Name;
            }
        }
        else
        {
            authors = await AuthorService.GetAuthors();
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (book is null)
        {
            return;
        }

        Result response = IdEdit != 0
            ? await BookService.UpdateBook(IdEdit, book)
            : await BookService.AddBook(book);

        if (response.Succeeded)
        {
            await NotificationService.ShowSuccessAsync(response.Message);
            NavigateBackToList();
            return;
        }

        await NotificationService.ShowErrorAsync(response.Message);
    }

    private void NavigateBackToList()
    {
        if (AuthorId != 0)
        {
            Navigation.NavigateTo($"/books/{AuthorId}");
            return;
        }

        Navigation.NavigateTo("/books");
    }
}
