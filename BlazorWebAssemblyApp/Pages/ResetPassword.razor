@* @page "/resetpassword" *@
@page "/resetpassword/{Token}"

@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using System.ComponentModel.DataAnnotations;


@inject IUserAccount AccountService
@inject IJSRuntime js

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="User" OnValidSubmit="HandleResetPassword">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="card-header">Reset Password</div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <input @bind="User.Email"
                               class="form-control"
                               type="email"
                               placeholder="Email Address">
                    </div>
                    <div class="form-group mb-3">
                        <input @bind="User.Password"
                               class="form-control"
                               type="password"
                               placeholder="New Password">
                    </div>
                    <div class="form-group mb-3">
                        <input @bind="User.ConfirmPassword"
                               class="form-control"
                               type="password"
                               placeholder="Confirm Password">
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary float-end"
                            type="submit">
                        Reset Password
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Token { get; set; }
    public ResetPasswordDTO User { get; set; } = new();

    async Task HandleResetPassword()
    {
        if(!string.IsNullOrEmpty(Token))
        User.Token = Token;
        var (flag, message) = await AccountService.ResetPassword(User);
        await js.InvokeVoidAsync("alert", message);
    }
}
