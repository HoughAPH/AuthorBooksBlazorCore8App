@page "/login"
@using BlazorWebAssemblyApp.Authentication
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager
@inject IUserAccount AccountService
@inject IJSRuntime js

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <EditForm Enhance Model="User" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="card-header fw-bold">Login to your Account</div>
                <div class="card-body">

                    <div class="form-group mb-3">
                        <input @bind="User.Email"
                               class="form-control"
                               type="email"
                               placeholder="Email Address">
                    </div>

                    <div class="form-group">
                        <div class="input-group mb-3">
                            <input id="pw" class="form-control" type="password"
                                   @bind="User.Password"
                                   placeholder="Password"
                                   aria-label="Password"
                                   aria-describedby="Password">
                        </div>
                    </div>

                </div>
                <div class="card-footer">
                    <button class="btn btn-primary float-end"
                            type="submit">
                        Login
                    </button>
                    <div>
                        Forgot password
                        <a href="/ForgotPassword">Click here</a>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    public LoginDTO User { get; set; } = new();

    private async Task HandleLogin()
    {
        var response = await AccountService.LoginAccount(User);

        if (response.Flag)
        {
            await AuthStateProvider.RefreshUserStateAsync();
            NavManager.NavigateTo("/", forceLoad: true);
            return;
        }

        await js.InvokeVoidAsync("alert", response.Message);
    }
}