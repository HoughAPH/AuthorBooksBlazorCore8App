@page "/authors"
@using Microsoft.AspNetCore.Components.Authorization
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAuthors AuthorsService
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Authors</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Authors</h2>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <button class="btn btn-primary" @onclick="NavigateToAuthorPage">Create New</button>
        </Authorized>
    </AuthorizeView>
</div>

<div class="row mb-3">
    <div class="col-md-6 col-xl-4">
        <div class="input-group">
            <input class="form-control" placeholder="Search authors" aria-label="Search authors"
                   @bind="search" @bind:event="oninput" @onkeydown="OnSearchKeyDownAsync" />
            <button class="btn btn-outline-secondary" type="button" @onclick="SearchAsync">Search</button>
        </div>
    </div>
</div>

@if (authors is null)
{
    <div class="d-flex align-items-center gap-2 text-secondary">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading...</span>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="fw-bold">Name</th>
                    <th scope="col" class="fw-bold">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (AuthorDTO author in authors)
                {
                    <tr>
                        <td>@author.Name</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" href="/books/@author.Id">Books</a>
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button type="button" class="btn btn-sm btn-outline-primary ms-1" @onclick="@(() => NavigateToEditAuthorPage(author.Id))">Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-1" @onclick="@(async () => await DeleteAsync(author.Id))">Delete</button>
                                </Authorized>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
                @if (authors.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-center text-secondary py-4">No authors found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <Pagination CurrentPage="currentPage"
                    TotalPages="totalPages"
                    OnPageChanged="HandlePageChangedAsync" />
    }
}

@code {
    private List<AuthorDTO>? authors;
    private int currentPage = 1;
    private const int pageSize = 5;
    private int totalPages = 1;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorsAsync();
    }

    private async Task LoadAuthorsAsync()
    {
        PagedResult<AuthorDTO> page = await AuthorsService.GetAuthorsPage(currentPage, pageSize, search);

        totalPages = Math.Max(page.TotalPages, 1);

        // The last page can disappear after a delete; step back and reload.
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
            page = await AuthorsService.GetAuthorsPage(currentPage, pageSize, search);
        }

        authors = [.. page.Items];
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAuthorsAsync();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task DeleteAsync(int id)
    {
        bool confirmed = await NotificationService.ConfirmAsync(
            "Delete Author",
            "Do you want to delete the author?");

        if (!confirmed)
        {
            return;
        }

        var response = await AuthorsService.DeleteAuthor(id);

        if (response.Succeeded)
        {
            await LoadAuthorsAsync();
            await NotificationService.ShowSuccessAsync(response.Message);
            return;
        }

        await NotificationService.ShowWarningAsync(response.Message, "Error deleting author");
    }

    private void NavigateToEditAuthorPage(int authorId)
    {
        Navigation.NavigateTo($"/author/{authorId}");
    }

    private void NavigateToAuthorPage()
    {
        Navigation.NavigateTo("/author");
    }

    private async Task HandlePageChangedAsync(int page)
    {
        currentPage = page;
        await LoadAuthorsAsync();
    }
}
