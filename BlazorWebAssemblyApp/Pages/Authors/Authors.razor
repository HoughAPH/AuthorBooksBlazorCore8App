@page "/authors"
@using Microsoft.AspNetCore.Components.Authorization
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAuthors AuthorsService
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Authors</PageTitle>

<h3 class="mb-2">Authors</h3>
<AuthorizeView Roles="Admin">
    <Authorized>
        <button class="btn btn-primary" @onclick="NavigateToAuthorPage">
            Create New
        </button>
    </Authorized>
</AuthorizeView>

<div class="input-group input-group-sm my-2" style="max-width: 28rem;">
    <input class="form-control" placeholder="Search authors" @bind="search" @bind:event="oninput" @onkeydown="OnSearchKeyDownAsync" />
    <button class="btn btn-outline-secondary" type="button" @onclick="SearchAsync">Search</button>
</div>

@if (authors is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-interactive">
    <table class="table table-sm table-striped mt-2" style="--bs-table-striped-bg: rgba(0, 0, 0, 0.15);">
        <tbody>
            @foreach (var author in authors)
            {
                <tr>
                    <td>@author.Name</td>
                    <td>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <button type="button" class="btn btn-primary" @onclick="@(() => NavigateToEditAuthorPage(author.Id))">
                                    <i class="oi oi-pencil">Edit</i>
                                </button>
                                <button id="DeleteAuthor" type="button" class="btn btn-danger btn-sm ms-2" @onclick="@(async () => await DeleteAsync(author.Id))">
                                    <i class="oi oi-trash">Delete</i>
                                </button>
                            </Authorized>
                        </AuthorizeView>

                        <a class="btn btn-primary btn-sm" href="/books/@author.Id">
                            <i class="oi oi-pencil">Author Books</i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
        @if (totalPages > 1)
        {
            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        OnPageChanged="HandlePageChangedAsync" />
        }
    </div>
}

@code {
    private List<AuthorDTO>? authors;
    private int currentPage = 1;
    private const int pageSize = 5;
    private int totalPages = 1;
    private string search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorsAsync();
    }

    private async Task LoadAuthorsAsync()
    {
        PagedResult<AuthorDTO> page = await AuthorsService.GetAuthorsPage(currentPage, pageSize, search);

        totalPages = Math.Max(page.TotalPages, 1);

        // The last page can disappear after a delete; step back and reload.
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
            page = await AuthorsService.GetAuthorsPage(currentPage, pageSize, search);
        }

        authors = [.. page.Items];
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAuthorsAsync();
    }

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task DeleteAsync(int id)
    {
        bool confirmed = await NotificationService.ConfirmAsync(
            "Delete Author",
            "Do you want to delete the author?");

        if (!confirmed)
        {
            return;
        }

        var response = await AuthorsService.DeleteAuthor(id);

        if (response.Succeeded)
        {
            await LoadAuthorsAsync();
            await NotificationService.ShowSuccessAsync(response.Message);
            return;
        }

        await NotificationService.ShowWarningAsync(response.Message, "Error deleting author");
    }

    private void NavigateToEditAuthorPage(int authorId)
    {
        Navigation.NavigateTo($"/author/{authorId}");
    }

    private void NavigateToAuthorPage()
    {
        Navigation.NavigateTo("/author");
    }

    private async Task HandlePageChangedAsync(int page)
    {
        currentPage = page;
        await LoadAuthorsAsync();
    }
}

