@page "/author"
@page "/author/{IdEdit:int}"
@using Microsoft.AspNetCore.Components.Forms
@using SharedClassLibrary.Contracts
@inject IAuthors AuthorsService
@inject IJSRuntime JSRuntime
@inject BlazorWebAssemblyApp.Services.INotificationService NotificationService

<PageTitle>Author</PageTitle>

@if (author == null)
{
    <div class="d-flex align-items-center gap-2 text-secondary">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <span>Loading...</span>
    </div>
}
else
{
    <div>
        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBackToList">
                        @(IdEdit != 0 ? "Back to List" : "Cancel")
                    </button>
                </div>
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title h4 mb-0">@headerTitle</h2>
                    </div>
                    <div class="card-body">
                        
                        <EditForm Enhance Model="author" OnValidSubmit="OnValidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mb-3">
                                <label for="AuthorName" class="form-label fw-bold">Author Name</label>
                                <InputText class="form-control" id="AuthorName" @bind-Value="author.Name"></InputText>
                            </div>
                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

