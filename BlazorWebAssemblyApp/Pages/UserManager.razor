@page "/usermanager"
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IManageUsers ManageUsersService
@inject SweetAlertService Swal

<PageTitle>Manage Users</PageTitle>

@if (users is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container mt-5">
        <h3 class="mb-4">Manage Users</h3>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>
                            <select class="form-control"
                                    value="@user.Role"
                                    @onchange="@(async e => await OnRoleChangedAsync(user, e.Value?.ToString() ?? user.Role))">
                                <option value="User">User</option>
                                @* <option value="Author">Author</option> *@
                                <option value="Admin">Admin</option>
                            </select>
                        </td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="@(async () => await DeleteUserAsync(user.Id))">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<ManageUserDTO>? users;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await ManageUsersService.GetUsers();
    }

    private async Task OnRoleChangedAsync(ManageUserDTO user, string newRole)
    {
        if (user.Role == newRole)
        {
            return;
        }

        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Update User Role",
            Text = $"Are you sure you want to change the role of {user.Name} to {newRole}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (!result.IsConfirmed)
        {
            StateHasChanged();
            return;
        }

        await ManageUsersService.UpdateUserRole(user.Id, newRole);
        user.Role = newRole;

        await Swal.FireAsync("Success", "User role updated successfully.", SweetAlertIcon.Success);
    }

    private async Task DeleteUserAsync(string userId)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "Delete User",
            Text = "Are you sure you want to delete this user?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (!result.IsConfirmed)
        {
            return;
        }

        await ManageUsersService.DeleteUser(userId);
        await LoadUsersAsync();

        await Swal.FireAsync("Success", "User deleted successfully.", SweetAlertIcon.Success);
    }
}
