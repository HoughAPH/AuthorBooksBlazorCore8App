@page "/usermanager"
@using Blazored.LocalStorage
@using SharedClassLibrary.Contracts
@using SharedClassLibrary.DTOs
@inject IManageUsers ManageUsersService
@inject ILocalStorageService LocalStorageService
@inject SweetAlertService Swal
@inject NavigationManager Navigation

<PageTitle>Manage Users</PageTitle>

@if (role != "Admin")
{
    <p>You do not have permission to view this page.</p>
}
else
{
    <div class="container mt-5">
        <h3 class="mb-4">Manage Users</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (users == null)
                {
                    <tr>
                        <td colspan="4"><em>Loading...</em></td>
                    </tr>
                }
                else
                {
                    @foreach (var user in users)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>
                                <InputSelect class="form-control" @bind-Value="user.Role" @onchange="@(async (e) => await UpdateUserRole(user))">
                                    <option value="User">User</option>
                                    <option value="Author">Author</option>
                                    <option value="Admin">Admin</option>
                                </InputSelect>
                            </td>
                            <td>
                                <button class="btn btn-danger btn-sm" @onclick="@(async () => await DeleteUser(user.Id))">Delete</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private string role = string.Empty;
    private List<ManageUserDTO> users = new();

    protected override async Task OnInitializedAsync()
    {
        role = await LocalStorageService.GetItemAsStringAsync("Role");
        if (role == "Admin")
        {
            users = await ManageUsersService.GetUsers();
        }
    }

    private async Task UpdateUserRole(ManageUserDTO user)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Update User Role",
                Text = $"Are you sure you want to change the role of {user.Name} to {user.Role}?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (result.IsConfirmed)
        {
            await ManageUsersService.UpdateUserRole(user.Id, user.Role);
            await Swal.FireAsync("Success", "User role updated successfully.", SweetAlertIcon.Success);
        }
    }

    private async Task DeleteUser(string userId)
    {
        var result = await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Delete User",
                Text = "Are you sure you want to delete this user?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (result.IsConfirmed)
        {
            await ManageUsersService.DeleteUser(userId);
            users = await ManageUsersService.GetUsers();
            await Swal.FireAsync("Success", "User deleted successfully.", SweetAlertIcon.Success);
        }
    }
}
