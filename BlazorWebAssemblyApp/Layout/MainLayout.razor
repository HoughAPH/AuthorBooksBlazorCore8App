@using BlazorWebAssemblyApp.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@using SharedClassLibrary.Contracts
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject IUserAccount AccountService
@inject NavigationManager NavManager
@inherits LayoutComponentBase

<div class="container-fluid">
    <div class="row min-vh-100">
        <div class="col-12 col-md-3 col-xl-2 bg-dark px-0">
            <NavMenu />
        </div>

        <div class="col-12 col-md-9 col-xl-10 px-0">
            <header class="navbar bg-body-tertiary border-bottom px-4 py-3 justify-content-end gap-2">
                <AuthorizeView>
                    <Authorized>
                        <span class="me-2">Signed in as <strong>@context.User.Identity?.Name</strong></span>
                        <button class="btn btn-outline-danger" @onclick="Logout">Logout</button>
                    </Authorized>
                    <NotAuthorized>
                        <span class="me-2">Welcome, Guest</span>
                        <button class="btn btn-outline-primary" @onclick="Signup">Sign up</button>
                        <button class="btn btn-primary" @onclick="Login">Login</button>
                    </NotAuthorized>
                </AuthorizeView>
            </header>

            <main class="p-4">
                @Body
            </main>
        </div>
    </div>
</div>

<script src="_content/CurrieTechnologies.Razor.SweetAlert2/sweetAlert2.min.js"></script>

@code {
    private async Task Logout()
    {
        await AccountService.LogoutAccount();
        AuthStateProvider.NotifyUserLogout();
        NavManager.NavigateTo("/login");
    }

    private void Signup()
    {
        NavManager.NavigateTo("/register");
    }

    private void Login()
    {
        NavManager.NavigateTo("/login");
    }
}
