@using Microsoft.AspNetCore.Components.Authorization
<div class="d-flex flex-column p-3" data-bs-theme="dark">
    <a class="navbar-brand fs-3 fw-bold text-white text-decoration-none mb-3" href="">Library Books</a>
    <hr class="mt-0" />

    <ul class="nav nav-pills flex-column gap-1">
        <li class="nav-item">
            <NavLink class="nav-link text-white fs-5 py-3" href="" Match="NavLinkMatch.All">Home</NavLink>
        </li>
        <AuthorizeView>
            <Authorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-white fs-5 py-3" href="books">Books</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white fs-5 py-3" href="authors">Authors</NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Admin">
            <li class="nav-item">
                <NavLink class="nav-link text-white fs-5 py-3" href="usermanager">Manage Users</NavLink>
            </li>
        </AuthorizeView>
    </ul>
</div>
