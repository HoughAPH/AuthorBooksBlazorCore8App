# Copy to .env (git-ignored) and replace every value. docker compose refuses to start until these are set.

# SQL Server 'sa' password: 8+ chars with upper, lower, digit and a symbol.
SA_PASSWORD=ChangeMe-Str0ng!Passw0rd

# JWT signing key: 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_KEY=

# Admin account created on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
